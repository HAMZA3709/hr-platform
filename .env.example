# --- Application ---
ENVIRONMENT=development
API_KEY=change-me-in-production
CORS_ALLOW_ORIGINS=*
RATE_LIMIT_PER_MINUTE=120

# --- Base de données ---
# SQLite pour un démarrage rapide sans rien installer :
DATABASE_URL=sqlite:///./hr_pipeline.db
# MySQL (production / docker-compose) :
# DATABASE_URL=mysql+pymysql://root:changeme@localhost:3306/hr_pipeline

# --- LLM (optionnel — sans clé, tout fonctionne en simulation locale) ---
LLM_PROVIDER=none
# none | anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# --- Audit / RGPD ---
AUDIT_PSEUDONYMIZATION_SALT=change-me-in-production
AUDIT_LOG_RETENTION_DAYS=365

# --- Prometheus ---
PROMETHEUS_PORT=8000

# --- OpenMetadata (optionnel) ---
OPENMETADATA_ENABLED=false
OPENMETADATA_HOST_PORT=http://localhost:8585/api
OPENMETADATA_JWT_TOKEN=

# --- Règles métier ---
MIN_YEARS_EXPERIENCE=1
MIN_REQUIRED_SKILLS_MATCHED_RATIO=0.5
MIN_SCORE_FOR_ONBOARDING=60.0

# --- Dashboard Streamlit ---
API_BASE_URL=http://localhost:8000
